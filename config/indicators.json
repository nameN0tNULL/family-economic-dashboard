{
  "version": 1,
  "resonance": {"watch": 2, "risk": 3},
  "dimensions": [
    {"id": "employment", "name": "就业安全", "weight": 25},
    {"id": "household", "name": "家庭财务安全", "weight": 25},
    {"id": "housing_city", "name": "房地产/城市", "weight": 20},
    {"id": "enterprise", "name": "企业经济", "weight": 20},
    {"id": "fiscal_policy", "name": "财政/政策环境", "weight": 10}
  ],
  "indicators": [
    {"id":"job_postings","name":"同岗招聘数量","dimension":"employment","frequency":"monthly","unit":"个","weight":2,"source":"BOSS直聘/智联/猎聘（固定搜索条件）","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-10,"red":-25}},
    {"id":"salary_mid","name":"同岗薪资中位数","dimension":"employment","frequency":"monthly","unit":"K/月","weight":2,"source":"招聘网站固定搜索条件","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-5,"red":-15}},
    {"id":"interview_leads","name":"猎头/面试机会","dimension":"employment","frequency":"monthly","unit":"次","weight":1,"source":"个人记录","risk_rule":{"basis":"six_month_pct","risk_direction":"lower_is_worse","yellow":-20,"red":-40}},
    {"id":"cash_runway_months","name":"家庭现金可撑月数","dimension":"household","frequency":"monthly","unit":"月","weight":3,"source":"家庭汇总数据","risk_rule":{"basis":"absolute","risk_direction":"lower_is_worse","yellow":12,"red":6}},
    {"id":"debt_service_ratio","name":"月供/税后收入","dimension":"household","frequency":"monthly","unit":"%","weight":2,"source":"家庭汇总数据","risk_rule":{"basis":"absolute","risk_direction":"higher_is_worse","yellow":30,"red":45}},
    {"id":"existing_home_sales","name":"二手房成交量","dimension":"housing_city","frequency":"monthly","unit":"套","weight":2,"source":"当地住建局/房管局/交易中心","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-15,"red":-30}},
    {"id":"home_days_on_market","name":"二手房成交周期","dimension":"housing_city","frequency":"monthly","unit":"天","weight":2,"source":"当地交易数据/贝壳等补充","risk_rule":{"basis":"yoy_pct","risk_direction":"higher_is_worse","yellow":15,"red":30}},
    {"id":"market_rent","name":"市场租金","dimension":"housing_city","frequency":"quarterly","unit":"元/月","weight":1,"source":"当地官方租赁数据/平台趋势","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-5,"red":-10}},
