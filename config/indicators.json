    {"id":"local_fiscal_revenue","name":"地方一般公共预算收入","dimension":"fiscal_policy","frequency":"quarterly","unit":"亿元","weight":2,"source":"当地财政局/人大预算报告","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-5,"red":-15}},
    {"id":"land_sale_revenue","name":"土地出让收入","dimension":"fiscal_policy","frequency":"quarterly","unit":"亿元","weight":1,"source":"当地财政局/财政部","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-15,"red":-30}},
    {"id":"private_investment","name":"民间固定资产投资","dimension":"enterprise","frequency":"monthly","unit":"指数","weight":2,"source":"国家统计局","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-5,"red":-10}},
    {"id":"private_profit","name":"私营/行业企业利润","dimension":"enterprise","frequency":"quarterly","unit":"指数","weight":2,"source":"国家统计局/行业数据/上市公司财报","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-10,"red":-20}},
    {"id":"corp_long_term_loans","name":"企业中长期贷款","dimension":"enterprise","frequency":"monthly","unit":"亿元","weight":1,"source":"中国人民银行","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-10,"red":-20}},
    {"id":"household_long_term_loans","name":"住户中长期贷款","dimension":"enterprise","frequency":"monthly","unit":"亿元","weight":1,"source":"中国人民银行","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-10,"red":-20}},
    {"id":"industry_orders_profit","name":"自己行业订单/利润","dimension":"employment","frequency":"quarterly","unit":"指数","weight":2,"source":"企业内部记录/行业协会/财报","risk_rule":{"basis":"yoy_pct","risk_direction":"lower_is_worse","yellow":-10,"red":-25}}
  ]
